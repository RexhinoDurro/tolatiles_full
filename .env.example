# ─────────────────────────────────────────────────────────────────────────────
# .env.example — add ALL of these to your Infisical project.
# Create two environments in Infisical: "dev" and "prod".
# Never commit real values here or in any .env file.
# ─────────────────────────────────────────────────────────────────────────────

# ── Django ────────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=replace-with-50-char-random-string
DJANGO_DEBUG=False                   # True in dev environment

# ── Database ──────────────────────────────────────────────────────────────────
# Dev: Docker builds DATABASE_URL from POSTGRES_PASSWORD (see docker-compose.yml)
# Prod: full connection string for the VPS postgres instance
POSTGRES_PASSWORD=devpassword        # dev only — used by docker-compose
DATABASE_URL=postgres://tolatiles:password@localhost:5432/tolatiles  # prod

# ── Redis / Celery ────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
REDIS_HOST=localhost                 # docker-compose overrides to "redis"

# ── Email (AWS WorkMail) ──────────────────────────────────────────────────────
WORKMAIL_PASS=your-workmail-smtp-password

# ── Google OAuth (Search Console) ────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Google Ads ────────────────────────────────────────────────────────────────
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=

# ── Web Push (VAPID) ──────────────────────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=menitola@tolatiles.com

# ── Gemini AI ─────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_IMAGE_API_KEY=

# ── Cloudflare Turnstile ──────────────────────────────────────────────────────
CLOUDFLARE_TURNSTILE_SECRET_KEY=

# ── Cloudflare R2 (blog media storage) ───────────────────────────────────────
# Optional: leave all four unset and blog media (AI-generated images,
# web-sourced images, inline content images, featured images) stays on local
# disk exactly as before -- no R2 account required to run this app. Set all
# four to move blog media to R2. See blog/storage.py. Gallery/Projects images
# are unaffected either way -- always local disk.
R2_BUCKET_NAME=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Public URL the bucket is reachable at -- a Cloudflare-dashboard custom
# domain mapped to the bucket (e.g. https://media.tolatiles.com), not the
# private R2 API endpoint. No trailing slash.
R2_PUBLIC_URL=

# ── Cloudflare R2 (financial document storage) ───────────────────────────────
# Optional: leave all three unset and quote/invoice/receipt/estimate PDFs stay
# on local disk exactly as before. Set all three to move them to R2. See
# quotes/storage.py. Reuses R2_ACCOUNT_ID above -- same Cloudflare account,
# separate bucket. Unlike blog media, this bucket must be PRIVATE (no custom
# domain, no public access enabled) -- these are customer financial documents,
# so the app serves them via short-lived signed URLs instead of a permanent
# public link.
R2_FINANCIAL_BUCKET_NAME=
R2_FINANCIAL_ACCESS_KEY_ID=
R2_FINANCIAL_SECRET_ACCESS_KEY=
# How long a signed PDF/receipt URL stays valid, in seconds. Optional --
# defaults to 86400 (24h) if unset.
R2_FINANCIAL_URL_EXPIRE_SECONDS=86400

# ── Misc ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=https://tolatiles.com   # http://localhost:3000 in dev
